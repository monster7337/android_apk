<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">#F3F3EA</item>
        <item name="android:statusBarColor">#F3F3EA</item>
        <item name="android:navigationBarColor">#15382E</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#397560</item>
        <item name="android:textColor">#173229</item>
        <item name="android:colorControlHighlight">#3340755F</item>
    </style>

    <style name="Heading">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">#173229</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold|italic</item>
        <item name="android:textColor">#305A4A</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="NumberField">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/field</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:inputType">numberSigned|numberDecimal</item>
        <item name="android:imeOptions">actionNext</item>
        <item name="android:selectAllOnFocus">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">#173229</item>
        <item name="android:textColorHint">#678174</item>
        <item name="android:hint">—</item>
    </style>

    <style name="RootText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">6dp</item>
        <item name="android:textColor">#173229</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textIsSelectable">true</item>
    </style>
</resources>
